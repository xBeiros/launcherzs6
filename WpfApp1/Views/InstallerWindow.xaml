<Window x:Class="WpfApp1.Views.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZODIAC SIX Setup"
        Icon="pack://application:,,,/Assets/ZodiacSix.ico"
        Width="820"
        Height="490"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Background="#131416"
            BorderBrush="#2E2F36"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Linke Artwork-Spalte (GTA VI / Leonida Visual) -->
                <ColumnDefinition Width="320" />
                <!-- Rechte Setup-Spalte (#131416) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Linke Spalte: Vollflächiges Leonida-Artwork -->
            <Border Grid.Column="0"
                    CornerRadius="13,0,0,13"
                    ClipToBounds="True"
                    MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Grid>
                    <Image Source="pack://application:,,,/Assets/social_4.png"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#B80D0E11" Offset="0.0" />
                                <GradientStop Color="#550D0E11" Offset="0.42" />
                                <GradientStop Color="#EB101113" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Margin="26,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Wortmarke oben -->
                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ZODIAC"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="22"
                                           FontWeight="Black"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="SIX"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="22"
                                           FontWeight="Black"
                                           Foreground="{StaticResource AccentGradientBrush}"
                                           Margin="3,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="R O L E P L A Y  ·  N E X T  G E N E R A T I O N"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="7"
                                       FontWeight="SemiBold"
                                       Foreground="#B8BAC2"
                                       Margin="1,1,0,0" />
                        </StackPanel>

                        <!-- Hero-Slogan unten -->
                        <StackPanel Grid.Row="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="16"
                                        Height="2"
                                        CornerRadius="1"
                                        Background="{StaticResource AccentGradientBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0" />
                                <TextBlock Text="GTA VI ROLEPLAY SETUP"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="9"
                                           Foreground="#E3CEBF" />
                            </StackPanel>

                            <TextBlock Text="WILLKOMMEN IN"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="28"
                                       FontWeight="Black"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       LineHeight="30" />
                            <TextBlock Text="LEONIDA."
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="32"
                                       FontWeight="Black"
                                       Foreground="{StaticResource AccentGradientBrush}"
                                       Margin="0,-2,0,10" />
                            <TextBlock Text="Einzeldatei-Installer ohne Ballast. Schnell, sauber und mit automatischem Updater."
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="11.5"
                                       Foreground="#C4C6CE"
                                       TextWrapping="Wrap"
                                       LineHeight="17" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Rechte Spalte: Moderne Setup-Konfiguration -->
            <Grid Grid.Column="1" Margin="28,22,26,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header mit Drag-Zone & Schließen -->
                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="LAUNCHER INSTALLIEREN"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}" />
                        <TextBlock Text="Setup-Optionen wählen"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Style="{StaticResource WindowCloseButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ToolTip="Setup schließen"
                            Click="CloseButton_Click">
                        <Path Data="M 1,1 L 8,8 M 8,1 L 1,8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Width="9"
                              Height="9"
                              Stretch="None" />
                    </Button>
                </Grid>

                <!-- Mitte: Pfad & Optionen -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,12">
                    <!-- Installationspfad -->
                    <TextBlock Text="INSTALLATIONSVERZEICHNIS"
                               Style="{StaticResource SectionEyebrowTextStyle}"
                               Margin="0,0,0,7" />
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#101113"
                                BorderBrush="#27282C"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,9">
                            <TextBox Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditOptions}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource AccentPrimaryBrush}"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="11"
                                     VerticalAlignment="Center" />
                        </Border>

                        <Button Grid.Column="2"
                                Content="Ändern"
                                IsEnabled="{Binding CanEditOptions}"
                                Click="BrowseFolder_Click"
                                Height="36"
                                Padding="14,0"
                                Background="#191A1E"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="#2E2F36"
                                BorderThickness="1"
                                Cursor="Hand"
                                FontFamily="{StaticResource PrimaryFontFamily}"
                                FontSize="11.5"
                                FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Optionen-Karte -->
                    <Border Background="#101113"
                            BorderBrush="#252629"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12"
                            IsEnabled="{Binding CanEditOptions}">
                        <StackPanel>
                            <Grid Margin="0,2,0,10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="Desktop-Verknüpfung erstellen"
                                               FontFamily="{StaticResource PrimaryFontFamily}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Direktzugriff vom Desktop auf ZODIAC SIX"
                                               FontFamily="{StaticResource PrimaryFontFamily}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                                <CheckBox HorizontalAlignment="Right"
                                          Style="{StaticResource ModernToggleSwitchStyle}"
                                          IsChecked="{Binding CreateDesktopShortcut}" />
                            </Grid>

                            <Border Height="1" Background="#1F2024" />

                            <Grid Margin="0,10,0,10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="Startmenü-Eintrag anlegen"
                                               FontFamily="{StaticResource PrimaryFontFamily}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Über die Windows-Suche sofort auffindbar"
                                               FontFamily="{StaticResource PrimaryFontFamily}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                                <CheckBox HorizontalAlignment="Right"
                                          Style="{StaticResource ModernToggleSwitchStyle}"
                                          IsChecked="{Binding CreateStartMenuShortcut}" />
                            </Grid>

                            <Border Height="1" Background="#1F2024" />

                            <Grid Margin="0,10,0,2">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="Autostart mit Windows"
                                               FontFamily="{StaticResource PrimaryFontFamily}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Hält den Launcher im Hintergrund automatisch aktuell"
                                               FontFamily="{StaticResource PrimaryFontFamily}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                                <CheckBox HorizontalAlignment="Right"
                                          Style="{StaticResource ModernToggleSwitchStyle}"
                                          IsChecked="{Binding EnableAutoStart}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Unten: Fortschritt & Installieren-/Starten-CTA -->
                <StackPanel Grid.Row="2">
                    <!-- Status & ProgressBar -->
                    <StackPanel Margin="0,0,0,14">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding StatusTitle}"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding StatusDetail}"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <ProgressBar Style="{StaticResource AccentProgressBarStyle}"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}" />
                    </StackPanel>

                    <!-- CTA vor Abschluss -->
                    <Button Command="{Binding StartInstallCommand}"
                            Height="48">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryCtaButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="ZODIAC SIX INSTALLIEREN"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="13"
                                   FontWeight="Black"
                                   Foreground="#140D0B"
                                   HorizontalAlignment="Center" />
                    </Button>

                    <!-- CTA nach Abschluss -->
                    <Button Command="{Binding LaunchInstalledCommand}"
                            Height="48">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryCtaButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="ZODIAC SIX JETZT STARTEN  ↗"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="13"
                                   FontWeight="Black"
                                   Foreground="#140D0B"
                                   HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
