<Window x:Class="WpfApp1.Views.UpdateSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZODIAC SIX Updater"
        Icon="pack://application:,,,/Assets/ZodiacSix.ico"
        Width="360"
        Height="350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="UpdateSplashWindow_Loaded">

    <Border Background="#131416"
            BorderBrush="#2C2D33"
            BorderThickness="1"
            CornerRadius="14"
            MouseLeftButtonDown="Splash_MouseLeftButtonDown">
        <Grid>
            <!-- Subtiles Leonida-Hintergrundbild -->
            <Border CornerRadius="13" ClipToBounds="True" IsHitTestVisible="False">
                <Grid>
                    <Image Source="pack://application:,,,/Assets/LauncherBackground.png"
                           Stretch="UniformToFill"
                           Opacity="0.18" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#CC131416" Offset="0.0" />
                                <GradientStop Color="#AA131416" Offset="0.45" />
                                <GradientStop Color="#F2131416" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <!-- Inhalt im Discord-Updater-Stil -->
            <Grid Margin="28,28,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Mitte: Animiertes Z6-Emblem + Marke -->
                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Pulsierendes/rotierendes Z6-Logo -->
                    <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <!-- Äußerer rotierender Gradient-Ring -->
                        <Ellipse Width="92"
                                 Height="92"
                                 StrokeThickness="2.5"
                                 StrokeDashArray="18 8"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF5A5F" Offset="0.0" />
                                    <GradientStop Color="#FF7F50" Offset="1.0" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="RingRotateTransform" Angle="0" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="RingRotateTransform"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0"
                                                             To="360"
                                                             Duration="0:0:4.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <!-- Innerer Z6-Kreis mit Glow -->
                        <Border Width="72"
                                Height="72"
                                CornerRadius="36"
                                Background="#191A1E"
                                BorderBrush="#35363D"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF5A5F"
                                                  BlurRadius="24"
                                                  ShadowDepth="0"
                                                  Opacity="0.45" />
                            </Border.Effect>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Z"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="34"
                                           FontWeight="Black"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="-10,-2,0,0" />
                                <TextBlock Text="6"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="18"
                                           FontWeight="Black"
                                           Foreground="{StaticResource AccentGradientBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="16,14,-6,-2" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Titel -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="ZODIAC"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="20"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="SIX"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="20"
                                   FontWeight="Black"
                                   Foreground="{StaticResource AccentGradientBrush}"
                                   Margin="4,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="AUTO-UPDATER"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="9"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- Status-Text & Fortschrittsbalken -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="{Binding StatusText}"
                               FontFamily="{StaticResource PrimaryFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding DetailText}"
                               FontFamily="{StaticResource PrimaryFontFamily}"
                               FontSize="10.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,14" />

                    <ProgressBar Style="{StaticResource AccentProgressBarStyle}"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}" />
                </StackPanel>

                <!-- Fußzeile -->
                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Ellipse Width="5"
                                 Height="5"
                                 Fill="{StaticResource AccentGradientBrush}"
                                 Margin="0,0,6,0" />
                        <TextBlock Text="LEONIDA NETWORK"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="8.5"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <TextBlock Text="{Binding VersionLabel}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="9"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
