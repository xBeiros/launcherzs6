<Window x:Class="WpfApp1.Views.UninstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZODIAC SIX Deinstallation"
        Icon="pack://application:,,,/Assets/ZodiacSix.ico"
        Width="780"
        Height="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border Background="#131416"
            BorderBrush="#2E2F36"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Linke Artwork-Spalte -->
                <ColumnDefinition Width="300" />
                <!-- Rechte Deinstallations-Spalte -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Linke Spalte: Leonida Night-Artwork -->
            <Border Grid.Column="0"
                    CornerRadius="13,0,0,13"
                    ClipToBounds="True"
                    MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Grid>
                    <Image Source="pack://application:,,,/Assets/social_3.png"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#C40D0E11" Offset="0.0" />
                                <GradientStop Color="#660D0E11" Offset="0.45" />
                                <GradientStop Color="#F0101113" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Margin="24,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Wortmarke -->
                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ZODIAC"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="22"
                                           FontWeight="Black"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="SIX"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="22"
                                           FontWeight="Black"
                                           Foreground="{StaticResource AccentGradientBrush}"
                                           Margin="3,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="U N I N S T A L L E R"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="8.5"
                                       Foreground="#B8BAC2"
                                       Margin="1,2,0,0" />
                        </StackPanel>

                        <!-- Abschieds-Headline -->
                        <StackPanel Grid.Row="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="16"
                                        Height="2"
                                        CornerRadius="1"
                                        Background="{StaticResource AccentGradientBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0" />
                                <TextBlock Text="RÜCKSTANDSFREIE ENTFERNUNG"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="8.5"
                                           Foreground="#E3CEBF" />
                            </StackPanel>

                            <TextBlock Text="BIS BALD IN"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="26"
                                       FontWeight="Black"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       LineHeight="28" />
                            <TextBlock Text="LEONIDA."
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="30"
                                       FontWeight="Black"
                                       Foreground="{StaticResource AccentGradientBrush}"
                                       Margin="0,-2,0,10" />
                            <TextBlock Text="Alle Dateien, Verknüpfungen und Windows-Einträge werden vollständig und sauber entfernt."
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="11"
                                       Foreground="#C4C6CE"
                                       TextWrapping="Wrap"
                                       LineHeight="17" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Rechte Spalte: Übersicht & Deinstallieren-Aktion -->
            <Grid Grid.Column="1" Margin="26,20,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="DEINSTALLATION"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentRoseBrush}" />
                        <TextBlock Text="ZODIAC SIX entfernen"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Style="{StaticResource WindowCloseButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ToolTip="Abbrechen"
                            Command="{Binding CloseCommand}">
                        <Path Data="M 1,1 L 8,8 M 8,1 L 1,8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Width="9"
                              Height="9"
                              Stretch="None" />
                    </Button>
                </Grid>

                <!-- Mitte: Was wird gelöscht + Option -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10">
                    <TextBlock Text="FOLGENDE ELEMENTE WERDEN VOLLSTÄNDIG ENTFERNT"
                               Style="{StaticResource SectionEyebrowTextStyle}"
                               Margin="0,0,0,8" />

                    <Border Background="#101113"
                            BorderBrush="#252629"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource AccentRoseBrush}" Margin="0,0,9,0" />
                                <TextBlock Text="Programmordner &amp; Launcher-Executable"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource AccentRoseBrush}" Margin="0,0,9,0" />
                                <TextBlock Text="Desktop- &amp; Startmenü-Verknüpfungen"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource AccentRoseBrush}" Margin="0,0,9,0" />
                                <TextBlock Text="Windows-Autostart &amp; Apps-Registry-Einträge"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Toggle für Cache & Temp-Daten -->
                    <Border Background="#101113"
                            BorderBrush="#252629"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12"
                            IsEnabled="{Binding CanEditOptions}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="Auch Cache- &amp; Temp-Daten löschen"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Entfernt lokale AppData-Reste und Updater-Dateien"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                            <CheckBox HorizontalAlignment="Right"
                                      Style="{StaticResource ModernToggleSwitchStyle}"
                                      IsChecked="{Binding RemoveCacheAndTempData}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Unten: Fortschritt & Buttons -->
                <StackPanel Grid.Row="2">
                    <StackPanel Margin="0,0,0,14">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding StatusTitle}"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding StatusDetail}"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <ProgressBar Style="{StaticResource AccentProgressBarStyle}"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Deinstallieren-Button -->
                    <Button Command="{Binding StartUninstallCommand}" Height="46">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryCtaButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="VOLLSTÄNDIG DEINSTALLIEREN"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="12.5"
                                   FontWeight="Black"
                                   Foreground="#140D0B"
                                   HorizontalAlignment="Center" />
                    </Button>

                    <!-- Schließen-Button nach Abschluss -->
                    <Button Command="{Binding CloseCommand}" Height="46">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryCtaButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="FERTIG &amp; SCHLIESSEN"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="12.5"
                                   FontWeight="Black"
                                   Foreground="#140D0B"
                                   HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
