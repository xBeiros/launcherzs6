<UserControl x:Class="WpfApp1.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WpfApp1.ViewModels">
    <UserControl.Resources>
        <!-- Filter-Pill-Style für Kategorie-Auswahl -->
        <Style x:Key="NewsFilterPillStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="#C814151A"
                                BorderBrush="#2A2B32"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="13,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#EB1D1E25" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#55FF7F50" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#26FF6B57" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="#FFF8F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,8,22,14">
        <!-- Übersicht: Moderner GTA VI / Leonida Editorial Feed -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedArticle}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Kopfbereich: Editorial Titel links & Kategorie-Filter rechts -->
            <Grid Grid.Row="0" Margin="2,2,2,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="18"
                                Height="2"
                                CornerRadius="1"
                                Background="{StaticResource AccentGradientBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,9,0" />
                        <TextBlock Text="DAS NÄCHSTE KAPITEL"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Foreground="#C8B4AA" />
                        <TextBlock Text="  ·  LEONIDA FEED"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="9.5"
                                   Foreground="#6D707B" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Neuigkeiten"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="."
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="{StaticResource AccentGradientBrush}" />
                    </StackPanel>

                    <TextBlock Text="Einblicke in die Vision von ZODIACSIX – wähle einen Beitrag für mehr Details."
                               FontFamily="{StaticResource PrimaryFontFamily}"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,5,0,0" />
                </StackPanel>

                <!-- Kategorie-Filter-Pills -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,2">
                    <RadioButton GroupName="NewsFilter"
                                 Content="Alle"
                                 Style="{StaticResource NewsFilterPillStyle}"
                                 IsChecked="{Binding IsAlleFilter, Mode=OneWay}"
                                 Command="{Binding SelectFilterCommand}"
                                 CommandParameter="Alle" />
                    <RadioButton GroupName="NewsFilter"
                                 Content="Vision"
                                 Style="{StaticResource NewsFilterPillStyle}"
                                 IsChecked="{Binding IsVisionFilter, Mode=OneWay}"
                                 Command="{Binding SelectFilterCommand}"
                                 CommandParameter="Vision" />
                    <RadioButton GroupName="NewsFilter"
                                 Content="Fraktionen"
                                 Style="{StaticResource NewsFilterPillStyle}"
                                 IsChecked="{Binding IsFraktionenFilter, Mode=OneWay}"
                                 Command="{Binding SelectFilterCommand}"
                                 CommandParameter="Fraktionen" />
                    <RadioButton GroupName="NewsFilter"
                                 Content="Wirtschaft"
                                 Style="{StaticResource NewsFilterPillStyle}"
                                 IsChecked="{Binding IsWirtschaftFilter, Mode=OneWay}"
                                 Command="{Binding SelectFilterCommand}"
                                 CommandParameter="Wirtschaft" />
                </StackPanel>
            </Grid>

            <!-- Moderne horizontale GTA-VI-Karten -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl ItemsSource="{Binding Articles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NewsArticleItem}">
                            <Button Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,12">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardBorder"
                                                Background="#EB131418"
                                                BorderBrush="#292A30"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Linker Akzentstreifen (leuchtet beim Hover im Coral-Gradient auf) -->
                                                <Border x:Name="AccentStripe"
                                                        Grid.Column="0"
                                                        Background="{StaticResource AccentGradientBrush}"
                                                        Opacity="0.22" />

                                                <Grid Grid.Column="1" Margin="15,13,18,13">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Thumbnail mit Vignette & Kapitelnummer-Badge -->
                                                    <Border x:Name="ThumbBorder"
                                                            Grid.Column="0"
                                                            Width="188"
                                                            Height="104"
                                                            CornerRadius="9"
                                                            ClipToBounds="True"
                                                            BorderBrush="#32333B"
                                                            BorderThickness="1"
                                                            Margin="0,0,22,0">
                                                        <Grid>
                                                            <Image Source="{Binding ImageUri}"
                                                                   Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                            <!-- Sanfte Leonida-Vignette -->
                                                            <Border>
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                        <GradientStop Color="#220D0E12" Offset="0.0" />
                                                                        <GradientStop Color="#000D0E12" Offset="0.45" />
                                                                        <GradientStop Color="#B80D0E12" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <!-- Kapitel-Index oben links -->
                                                            <Border HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Margin="8,8,0,0"
                                                                    CornerRadius="5"
                                                                    Background="#CC101116"
                                                                    BorderBrush="#44FFFFFF"
                                                                    BorderThickness="1"
                                                                    Padding="6,2">
                                                                <TextBlock Text="{Binding NumberLabel}"
                                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                                           FontSize="9.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="#FFF5F0" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Text-Block Mitte -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <!-- Kategorie-Pill + Lesezeit -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                            <Border Background="#1EFF6B57"
                                                                    BorderBrush="#44FF7F50"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="7,2">
                                                                <TextBlock Text="{Binding Category}"
                                                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                                                           FontSize="8.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource AccentPrimaryBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding ReadTime}"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="8.5"
                                                                       Foreground="#767985"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0,0,0" />
                                                        </StackPanel>

                                                        <!-- Titel -->
                                                        <TextBlock x:Name="TitleText"
                                                                   Text="{Binding Title}"
                                                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                                                   FontSize="17.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />

                                                        <!-- Kurzbeschreibung -->
                                                        <TextBlock Text="{Binding Subtitle}"
                                                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                                                   FontSize="11.5"
                                                                   Foreground="#9EA2AE"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,6,18,0" />
                                                    </StackPanel>

                                                    <!-- Rechts: Moderner Action-Kreis mit ↗ -->
                                                    <Border x:Name="ArrowPill"
                                                            Grid.Column="2"
                                                            Width="36"
                                                            Height="36"
                                                            CornerRadius="18"
                                                            Background="#1B1C22"
                                                            BorderBrush="#2E3038"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center"
                                                            Margin="12,0,4,0">
                                                        <TextBlock x:Name="ArrowIcon"
                                                                   Text="↗"
                                                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="#9B9EA8"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#F5181920" />
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#77FF7F50" />
                                                <Setter TargetName="AccentStripe" Property="Opacity" Value="1" />
                                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#66FF7F50" />
                                                <Setter TargetName="ArrowPill" Property="Background" Value="#2BFF6B57" />
                                                <Setter TargetName="ArrowPill" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                                <Setter TargetName="ArrowIcon" Property="Foreground" Value="#FFF8F5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Cinematische Detail-Ansicht beim Klick auf einen Beitrag -->
        <Border Background="#F2121317"
                BorderBrush="#292A31"
                BorderThickness="1"
                CornerRadius="13"
                ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedArticle}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="205" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Vollflächiger GTA-VI-Header mit Bild & Verlauf -->
                <Grid Grid.Row="0" ClipToBounds="True">
                    <Image Source="{Binding SelectedArticle.ImageUri}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#770C0D10" Offset="0.0" />
                                <GradientStop Color="#990E0F13" Offset="0.5" />
                                <GradientStop Color="#FF121317" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Zurück-Button oben links über dem Artwork -->
                    <Button Command="{Binding CloseArticleCommand}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="22,18,0,0"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BackBd"
                                        Background="#CC121318"
                                        BorderBrush="#44FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="13,6">
                                    <TextBlock Text="←  Zurück zu den Neuigkeiten"
                                               FontFamily="{StaticResource PrimaryFontFamily}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#FFF8F5" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BackBd" Property="Background" Value="#EB1C1E26" />
                                        <Setter TargetName="BackBd" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Kategorie + Titel unten im Hero-Banner -->
                    <StackPanel VerticalAlignment="Bottom" Margin="26,0,26,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Border Background="#33FF6B57"
                                    BorderBrush="#88FF7F50"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2">
                                <TextBlock Text="{Binding SelectedArticle.Category}"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="#FF9E7B" />
                            </Border>
                            <TextBlock Text="{Binding SelectedArticle.ReadTime}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="9"
                                       Foreground="#C4C7D2"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedArticle.Title}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="25"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Artikeltext & Highlight-Quote -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="26,10,26,16">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <!-- Korall-Zitat-Box -->
                        <Border Background="#181920"
                                BorderBrush="{StaticResource AccentPrimaryBrush}"
                                BorderThickness="2.5,0,0,0"
                                CornerRadius="0,8,8,0"
                                Padding="16,11"
                                Margin="0,0,0,16">
                            <TextBlock Text="{Binding SelectedArticle.HighlightQuote}"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       FontStyle="Italic"
                                       Foreground="#F0DDD6"
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="{Binding SelectedArticle.FullText}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="13"
                                   Foreground="#D4D6DE"
                                   TextWrapping="Wrap"
                                   LineHeight="22" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Untere Aktionsleiste: Meta & Nächster Beitrag -->
                <Border Grid.Row="2"
                        Background="#15161B"
                        BorderBrush="#24252C"
                        BorderThickness="0,1,0,0"
                        Padding="26,12">
                    <Grid>
                        <TextBlock Text="{Binding SelectedArticle.PublishedDate}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />

                        <Button Command="{Binding NextArticleCommand}"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="NextBd"
                                            Background="#24FF6B57"
                                            BorderBrush="#66FF7F50"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="14,6">
                                        <TextBlock Text="Nächster Beitrag  →"
                                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#FFF6F2" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NextBd" Property="Background" Value="#3DFF6B57" />
                                            <Setter TargetName="NextBd" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
