<UserControl x:Class="WpfApp1.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WpfApp1.ViewModels">
    <Grid Margin="22,8,22,14">
        <!-- Übersicht: Header + 3 Neuigkeiten-Karten wie im Design -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedArticle}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Kopfbereich -->
            <StackPanel Grid.Row="0" Margin="2,4,0,22">
                <TextBlock Text="DAS NÄCHSTE KAPITEL"
                           FontFamily="{StaticResource PrimaryFontFamily}"
                           FontSize="9.5"
                           FontWeight="Bold"
                           Foreground="#9699A4"
                           Margin="0,0,0,6" />
                <TextBlock Text="Neuigkeiten."
                           FontFamily="{StaticResource PrimaryFontFamily}"
                           FontSize="28"
                           FontWeight="Black"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Einblicke in die Vision von ZODIACSIX. Aktuelle Beiträge und Updates."
                           FontFamily="{StaticResource PrimaryFontFamily}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- Liste der Neuigkeiten-Karten -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl ItemsSource="{Binding Articles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NewsArticleItem}">
                            <Button Command="{Binding DataContext.OpenArticleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    HorizontalContentAlignment="Stretch"
                                    Margin="0,0,0,12">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardBorder"
                                                Background="#EB131417"
                                                BorderBrush="#27282D"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="16,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Linkes Thumbnail mit abgerundeten Ecken -->
                                                <Border Grid.Column="0"
                                                        Width="156"
                                                        Height="88"
                                                        CornerRadius="8"
                                                        ClipToBounds="True"
                                                        BorderBrush="#2E2F36"
                                                        BorderThickness="1"
                                                        Margin="0,0,22,0">
                                                    <Image Source="{Binding ImageUri}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>

                                                <!-- Text-Block Mitte -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}"
                                                               FontFamily="{StaticResource PrimaryFontFamily}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource AccentPrimaryBrush}"
                                                               Margin="0,0,0,7" />
                                                    <TextBlock Text="{Binding Title}"
                                                               FontFamily="{StaticResource PrimaryFontFamily}"
                                                               FontSize="17"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               FontFamily="{StaticResource PrimaryFontFamily}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,8,0,0" />
                                                </StackPanel>

                                                <!-- Pfeil rechts (↗) -->
                                                <TextBlock x:Name="ArrowIcon"
                                                           Grid.Column="2"
                                                           Text="↗"
                                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#8A8D96"
                                                           VerticalAlignment="Center"
                                                           Margin="16,0,8,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#F518191E" />
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#66FF7F50" />
                                                <Setter TargetName="ArrowIcon" Property="Foreground" Value="{StaticResource AccentPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Detail-Ansicht beim Klick auf einen Beitrag -->
        <Border Background="#F0131417"
                BorderBrush="#27282D"
                BorderThickness="1"
                CornerRadius="12"
                Padding="26,22">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedArticle}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Command="{Binding CloseArticleCommand}"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BackBd"
                                    Background="#191A1F"
                                    BorderBrush="#2D2F36"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="12,6">
                                <TextBlock Text="←  Zurück zu den Neuigkeiten"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BackBd" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            CornerRadius="10"
                            ClipToBounds="True"
                            BorderBrush="#2E2F36"
                            BorderThickness="1"
                            VerticalAlignment="Top"
                            Height="220">
                        <Image Source="{Binding SelectedArticle.ImageUri}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="{Binding SelectedArticle.Category}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentPrimaryBrush}" />
                        <TextBlock Text="{Binding SelectedArticle.Title}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="24"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,6" />
                        <TextBlock Text="{Binding SelectedArticle.PublishedDate}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,18" />
                        <TextBlock Text="{Binding SelectedArticle.FullText}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="13.5"
                                   Foreground="#D4D6DE"
                                   TextWrapping="Wrap"
                                   LineHeight="22" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
