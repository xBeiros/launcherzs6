<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =================================================================== -->
    <!-- ZODIAC SIX - Offizielle Farbpalette (#FF5A5F & #FF7F50 + #131416)   -->
    <!-- =================================================================== -->

    <!-- Dashboard & Karten-Hintergrundfarben (einheitlich #131416) -->
    <Color x:Key="WindowBackgroundColor">#101113</Color>
    <Color x:Key="SurfaceCardColor">#131416</Color>
    <Color x:Key="SurfaceCardSolidColor">#131416</Color>
    <Color x:Key="SurfaceCardHoverColor">#1B1C20</Color>
    <Color x:Key="SurfaceElevatedColor">#191A1D</Color>
    <Color x:Key="SurfaceInputColor">#131416</Color>
    <Color x:Key="TopBarBackgroundColor">#131416</Color>

    <!-- Rahmen & Trennlinien -->
    <Color x:Key="BorderSubtleColor">#27282C</Color>
    <Color x:Key="BorderHoverColor">#3B3C42</Color>
    <Color x:Key="DividerColor">#252629</Color>

    <!-- Offizielle ZODIAC SIX Akzentfarben (#FF7F50 & #FF5A5F) -->
    <Color x:Key="AccentPrimaryColor">#FF7F50</Color>
    <Color x:Key="AccentRoseColor">#FF5A5F</Color>
    <Color x:Key="AccentPrimaryHoverColor">#FF936A</Color>
    <Color x:Key="AccentPrimaryPressedColor">#E54E53</Color>
    <Color x:Key="AccentPrimarySubtleColor">#24FF5A5F</Color>
    <Color x:Key="AccentBorderSubtleColor">#66FF7F50</Color>

    <!-- Statusfarben -->
    <Color x:Key="StatusOnlineColor">#34D399</Color>
    <Color x:Key="StatusOnlineSubtleColor">#1C34D399</Color>
    <Color x:Key="StatusWarningColor">#FF7F50</Color>
    <Color x:Key="StatusErrorColor">#FF5A5F</Color>
    <Color x:Key="StatusErrorSubtleColor">#22FF5A5F</Color>
    <Color x:Key="DiscordBrandColor">#FF7F50</Color>

    <!-- Textfarben -->
    <Color x:Key="TextPrimaryColor">#F3F1EF</Color>
    <Color x:Key="TextSecondaryColor">#8A8B90</Color>
    <Color x:Key="TextMutedColor">#676970</Color>

    <!-- =================================================================== -->
    <!-- SolidColorBrushes                                                   -->
    <!-- =================================================================== -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="SurfaceCardSolidBrush" Color="{StaticResource SurfaceCardSolidColor}" />
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="{StaticResource SurfaceCardHoverColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInputColor}" />
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="{StaticResource TopBarBackgroundColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentRoseBrush" Color="{StaticResource AccentRoseColor}" />
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{StaticResource AccentPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="{StaticResource AccentPrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentPrimarySubtleBrush" Color="{StaticResource AccentPrimarySubtleColor}" />
    <SolidColorBrush x:Key="AccentBorderSubtleBrush" Color="{StaticResource AccentBorderSubtleColor}" />

    <SolidColorBrush x:Key="StatusOnlineBrush" Color="{StaticResource StatusOnlineColor}" />
    <SolidColorBrush x:Key="StatusOnlineSubtleBrush" Color="{StaticResource StatusOnlineSubtleColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="StatusErrorSubtleBrush" Color="{StaticResource StatusErrorSubtleColor}" />
    <SolidColorBrush x:Key="DiscordBrandBrush" Color="{StaticResource DiscordBrandColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- =================================================================== -->
    <!-- Verläufe (ZODIAC SIX Signatur-Gradient: #FF5A5F -> #FF7F50)         -->
    <!-- =================================================================== -->

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0.2" EndPoint="1,0.8">
        <GradientStop Color="#FF5A5F" Offset="0.0" />
        <GradientStop Color="#FF7F50" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0.2" EndPoint="1,0.8">
        <GradientStop Color="#FF6E72" Offset="0.0" />
        <GradientStop Color="#FF936A" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CacheProgressGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF5A5F" Offset="0.0" />
        <GradientStop Color="#FF7F50" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Hero-Shade: links 92% dunkel -> Mitte 42% -> rechts 10% transparent -->
    <LinearGradientBrush x:Key="HeroOverlayGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#EB0D0E11" Offset="0.0" />
        <GradientStop Color="#660E0E12" Offset="0.54" />
        <GradientStop Color="#1A0E0E12" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroBottomFadeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#00101113" Offset="0.45" />
        <GradientStop Color="#7A101113" Offset="1.0" />
    </LinearGradientBrush>

    <!-- =================================================================== -->
    <!-- Abstände & Radien                                                   -->
    <!-- =================================================================== -->

    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="WindowCornerRadius">12</CornerRadius>

    <Thickness x:Key="CardPadding">18</Thickness>

    <!-- Typografie -->
    <FontFamily x:Key="PrimaryFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>
