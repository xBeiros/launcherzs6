<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:WpfApp1.Components"
        xmlns:views="clr-namespace:WpfApp1.Views"
        xmlns:vm="clr-namespace:WpfApp1.ViewModels"
        Title="ZODIAC SIX Launcher"
        Icon="pack://application:,,,/Assets/ZodiacSix.ico"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- ViewModel -> View Zuordnung für den ContentControl-Container -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NewsViewModel}">
            <views:NewsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <Border Margin="22,6,22,12"
                    Style="{StaticResource LauncherCardBorderStyle}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="440">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="10"
                            Background="{StaticResource AccentPrimarySubtleBrush}"
                            BorderBrush="{StaticResource AccentBorderSubtleBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,14">
                        <TextBlock Text="Z6"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="18"
                                   FontWeight="Black"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Title}"
                               FontFamily="{StaticResource PrimaryFontFamily}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontFamily="{StaticResource PrimaryFontFamily}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Haupt-Container mit abgerundeten Ecken und feiner Rahmenlinie (#383334 wie Referenz) -->
    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="#353133"
            BorderThickness="1"
            CornerRadius="{StaticResource WindowCornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Zeile 0: TopBar (solide #131416 bis zur oberen Trennlinie) -->
                <RowDefinition Height="Auto" />
                <!-- Zeile 1: Navigation-Tabs & Discord-Benutzerprofil -->
                <RowDefinition Height="64" />
                <!-- Zeile 2: Dynamischer Content-Bereich (DashboardView / weitere Tabs) -->
                <RowDefinition Height="*" />
                <!-- Zeile 3: Schmale Footer-Leiste (solide #131416 ab der unteren Trennlinie) -->
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Hochgeladener Leonida-Map & Marina Hintergrund exakt zwischen oberer Linie (Row 1) und unterer Linie (Row 2) -->
            <Border Grid.Row="1"
                    Grid.RowSpan="2"
                    ClipToBounds="True"
                    IsHitTestVisible="False">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/LauncherBackground.png"
                                Stretch="UniformToFill"
                                AlignmentX="Center"
                                AlignmentY="Center"
                                Opacity="0.34" />
                </Border.Background>
                <!-- Feiner dunkler Verlauf wie in der Referenz (klar sichtbare Map + maximale Lesbarkeit) -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#44101113" Offset="0.0" />
                            <GradientStop Color="#1A101113" Offset="0.48" />
                            <GradientStop Color="#4D101113" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>

            <!-- 1. TopBarControl -->
            <components:TopBarControl Grid.Row="0" />

            <!-- 2. Navigation-Tabs & Benutzerprofil -->
            <Grid Grid.Row="1" Margin="22,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Navigation-Tabs mit Icons -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Start -->
                        <RadioButton GroupName="MainNavigation"
                                     Style="{StaticResource NavTabRadioButtonStyle}"
                                     IsChecked="{Binding IsStartSelected, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Start">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 10,20 L 10,14 L 14,14 L 14,20 L 19,20 L 19,12 L 22,12 L 12,3 L 2,12 L 5,12 L 5,20 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7"
                                      Fill="Transparent"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,9,0" />
                                <TextBlock Text="Start" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Neuigkeiten -->
                        <RadioButton GroupName="MainNavigation"
                                     Style="{StaticResource NavTabRadioButtonStyle}"
                                     IsChecked="{Binding IsNeuigkeitenSelected, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Neuigkeiten">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 4,4 L 20,4 L 20,20 L 4,20 Z M 8,9 L 16,9 M 8,13 L 16,13 M 8,17 L 13,17"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.7"
                                      Fill="Transparent"
                                      Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,9,0" />
                                <TextBlock Text="Neuigkeiten" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Einstellungen -->
                        <RadioButton GroupName="MainNavigation"
                                     Style="{StaticResource NavTabRadioButtonStyle}"
                                     IsChecked="{Binding IsEinstellungenSelected, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Einstellungen">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 12,8.5 C 10.07,8.5 8.5,10.07 8.5,12 C 8.5,13.93 10.07,15.5 12,15.5 C 13.93,15.5 15.5,13.93 15.5,12 C 15.5,10.07 13.93,8.5 12,8.5 Z M 19.4,13 L 21,12 L 19.4,11 L 19.1,9.3 L 20.5,8 L 19,6.5 L 17.7,7.9 L 16,7.6 L 15,6 L 13,6 L 12,7.6 L 10.3,7.9 L 9,6.5 L 7.5,8 L 8.9,9.3 L 8.6,11 L 7,12 L 8.6,13 L 8.9,14.7 L 7.5,16 L 9,17.5 L 10.3,16.1 L 12,16.4 L 13,18 L 15,18 L 16,16.4 L 17.7,16.1 L 19,17.5 L 20.5,16 L 19.1,14.7 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4"
                                      Fill="Transparent"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,9,0" />
                                <TextBlock Text="Einstellungen" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Discord-Login-Button rechts -->
                    <Button Grid.Column="2"
                            Command="{Binding DiscordLoginCommand}"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="Mit deinem Discord-Account anmelden">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="DiscordBtnBorder"
                                        Background="#1B1D24"
                                        BorderBrush="#445865F2"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="10,6,14,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Discord-Icon-Badge -->
                                        <Border x:Name="DiscordIconBadge"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="7"
                                                Background="#295865F2"
                                                BorderBrush="#555865F2"
                                                BorderThickness="1"
                                                Margin="0,0,10,0">
                                            <Path Data="M 20,4 C 18.4,3.3 16.7,2.8 15,2.5 L 14.4,3.8 C 12.8,3.6 11.2,3.6 9.6,3.8 L 9,2.5 C 7.3,2.8 5.6,3.3 4,4 C 1.5,7.8 0.8,11.5 1.1,15.2 C 3.2,16.8 5.3,17.7 7.3,18.4 L 8.5,16.7 C 7.5,16.3 6.6,15.9 5.7,15.3 L 6.3,14.8 C 9.9,16.5 14.1,16.5 17.7,14.8 L 18.3,15.3 C 17.4,15.9 16.5,16.3 15.5,16.7 L 16.7,18.4 C 18.7,17.7 20.8,16.8 22.9,15.2 C 23.3,10.9 22.2,7.2 20,4 Z M 8.5,13 C 7.5,13 6.8,12.1 6.8,11 C 6.8,9.9 7.5,9 8.5,9 C 9.5,9 10.2,9.9 10.2,11 C 10.2,12.1 9.5,13 8.5,13 Z M 15.5,13 C 14.5,13 13.8,12.1 13.8,11 C 13.8,9.9 14.5,9 15.5,9 C 16.5,9 17.2,9.9 17.2,11 C 17.2,12.1 16.5,13 15.5,13 Z"
                                                  Fill="#8EA1FF"
                                                  Width="15"
                                                  Height="15"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DiscordLoginLabel}"
                                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding DiscordStatusText}"
                                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                                       FontSize="8.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#9CA3BC"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DiscordBtnBorder" Property="Background" Value="#242736" />
                                        <Setter TargetName="DiscordBtnBorder" Property="BorderBrush" Value="#995865F2" />
                                        <Setter TargetName="DiscordIconBadge" Property="Background" Value="#445865F2" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="DiscordBtnBorder" Property="Background" Value="#1E202C" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 3. Aktive View (ContentControl) -->
                <ContentControl Grid.Row="2"
                                Content="{Binding CurrentView}" />

                <!-- 4. Schmale Footer-Leiste (solide #131416 ab unterer Trennlinie) -->
                <Border Grid.Row="3"
                        Background="{StaticResource TopBarBackgroundBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12"
                        Padding="22,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Links: Punkt + ZODIACSIX LAUNCHER + CONCEPT 03 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="5"
                                     Height="5"
                                     Fill="{StaticResource AccentPrimaryBrush}"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="{Binding FooterBrand}"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding FooterConcept}"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="10,0,0,0" />
                        </StackPanel>

                        <!-- Mitte: DEINE STADT. DEINE GESCHICHTE. -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FooterTagline}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />

                        <!-- Rechts: Über diese Vorschau ↗ -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding FooterPreviewLink}"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="9.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text=" ↗"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="9.5"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
        </Grid>
    </Border>
</Window>
