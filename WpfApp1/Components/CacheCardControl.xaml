<UserControl x:Class="WpfApp1.Components.CacheCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource LauncherCardBorderStyle}" Padding="20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Karten-Header: FIVEM CACHE + LIVE Badge -->
            <Grid Grid.Row="0">
                <TextBlock Text="FIVEM CACHE"
                           Style="{StaticResource SectionEyebrowTextStyle}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />

                <Border Style="{StaticResource DemoPillBadgeStyle}"
                        HorizontalAlignment="Right">
                    <TextBlock Text="LIVE"
                               FontFamily="{StaticResource PrimaryFontFamily}"
                               FontSize="8.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource StatusOnlineBrush}" />
                </Border>
            </Grid>

            <!-- Metrik-Zeile & schmaler Fortschrittsbalken -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,10">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Links: 2,48 GB + LOKALE CLIENTDATEIEN -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding CacheSizeNumber}"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="29"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text=" GB"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="3,0,0,5" />
                        </StackPanel>
                        <TextBlock Text="LOKALE CLIENTDATEIEN"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <!-- Rechts: ZULETZT GELEERT / Noch nie · Demo -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="ZULETZT GELEERT"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding LastClearedText}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="11"
                                   Foreground="#B5BAC4"
                                   HorizontalAlignment="Right"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <ProgressBar Style="{StaticResource AccentProgressBarStyle}"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding CacheUsagePercent, Mode=OneWay}" />
            </StackPanel>

            <!-- Hold-to-Clear Button ("GEDRÜCKT HALTEN ZUM LEEREN" + "2 s") -->
            <Button x:Name="HoldClearButton"
                    Grid.Row="2"
                    Style="{StaticResource HoldActionButtonStyle}"
                    PreviewMouseLeftButtonDown="HoldClearButton_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="HoldClearButton_PreviewMouseLeftButtonUp"
                    PreviewKeyDown="HoldClearButton_PreviewKeyDown"
                    PreviewKeyUp="HoldClearButton_PreviewKeyUp"
                    MouseLeave="HoldClearButton_MouseLeave"
                    LostMouseCapture="HoldClearButton_LostMouseCapture"
                    Margin="0,0,0,8">
                <Grid>
                    <!-- Fortschritts-Overlay während des Gedrückthaltens -->
                    <Border x:Name="HoldProgressFill"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Opacity="0.32"
                            HorizontalAlignment="Left"
                            Width="0" />

                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Backspace/Clear Icon -->
                        <Path Grid.Column="0"
                              Data="M 22,3 L 7,3 C 6.31,3 5.77,3.35 5.41,3.88 L 0,12 L 5.41,20.11 C 5.77,20.64 6.31,21 7,21 L 22,21 C 23.1,21 24,20.1 24,19 L 24,5 C 24,3.9 23.1,3 22,3 Z M 19,15.59 L 17.59,17 L 14,13.41 L 10.41,17 L 9,15.59 L 12.59,12 L 9,8.41 L 10.41,7 L 14,10.59 L 17.59,7 L 19,8.41 L 15.41,12 Z"
                              Stroke="{StaticResource AccentPrimaryBrush}"
                              StrokeThickness="1.3"
                              Fill="Transparent"
                              Width="15"
                              Height="12"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0" />

                        <TextBlock x:Name="HoldButtonLabel"
                                   Grid.Column="1"
                                   Text="GEDRÜCKT HALTEN ZUM LEEREN"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />

                        <TextBlock x:Name="HoldCountdownLabel"
                                   Grid.Column="2"
                                   Text="2 s"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Button>

            <!-- Dezente Fußzeile in der Karte -->
            <TextBlock Grid.Row="3"
                       Text="2 Sekunden halten · auch mit Leertaste oder Enter"
                       FontFamily="{StaticResource PrimaryFontFamily}"
                       FontSize="9.5"
                       Foreground="{StaticResource TextMutedBrush}" />
        </Grid>
    </Border>
</UserControl>
