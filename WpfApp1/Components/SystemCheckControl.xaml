<UserControl x:Class="WpfApp1.Components.SystemCheckControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WpfApp1.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: — SYSTEMCHECK | DEMO + Refresh -->
        <Grid Grid.Row="0" Margin="2,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border Width="14"
                        Height="1.5"
                        Background="{StaticResource AccentPrimaryBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />
                <TextBlock Text="SYSTEMCHECK"
                           Style="{StaticResource SectionEyebrowTextStyle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Style="{StaticResource DemoPillBadgeStyle}" Margin="0,0,8,0">
                    <TextBlock Text="LIVE"
                               FontFamily="{StaticResource PrimaryFontFamily}"
                               FontSize="8.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource StatusOnlineBrush}" />
                </Border>

                <Button Style="{StaticResource IconGhostButtonStyle}"
                        Command="{Binding RefreshSystemChecksCommand}"
                        ToolTip="Systemkomponenten erneut prüfen">
                    <Path Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4.01,7.58 4.01,12 C 4.01,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 L 17.65,14 C 16.83,16.33 14.61,18 12,18 C 8.69,18 6,15.31 6,12 C 6,8.69 8.69,6 12,6 C 13.66,6 15.14,6.69 16.22,7.78 L 13,11 L 20,11 L 20,4 L 17.65,6.35 Z"
                          Fill="{StaticResource AccentPrimaryBrush}"
                          Width="13"
                          Height="13"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Äußerer Container für alle 5 Systemcheck-Einträge -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8">
            <ItemsControl ItemsSource="{Binding SystemChecks}"
                          VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SystemCheckItem}">
                        <Border Background="#131416"
                                BorderBrush="#27282C"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,6"
                                Margin="0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- App-Icon-Box -->
                                <Border Grid.Column="0"
                                        Width="30"
                                        Height="30"
                                        CornerRadius="7"
                                        Background="#1B181A"
                                        BorderBrush="#2E2627"
                                        BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <Grid>
                                        <!-- GTA V Text-Icon -->
                                        <TextBlock Text="V"
                                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Black"
                                                   FontStyle="Italic"
                                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconType}" Value="{x:Static models:SystemCheckIconType.GtaSix}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- FiveM Text-Icon -->
                                        <TextBlock Text="5M"
                                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                                   FontSize="11.5"
                                                   FontWeight="Black"
                                                   FontStyle="Italic"
                                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconType}" Value="{x:Static models:SystemCheckIconType.SixM}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Vektor-Icons für Teamspeak, Saltychat & Discord -->
                                        <Path Width="14"
                                              Height="14"
                                              Stretch="Uniform"
                                              Fill="{StaticResource AccentPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconType}" Value="{x:Static models:SystemCheckIconType.Teamspeak}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Data" Value="M 12,3 C 7.03,3 3,7.03 3,12 L 3,19 C 3,20.1 3.9,21 5,21 L 8,21 L 8,13 L 5,13 L 5,12 C 5,8.13 8.13,5 12,5 C 15.87,5 19,8.13 19,12 L 19,13 L 16,13 L 16,21 L 19,21 C 20.1,21 21,20.1 21,19 L 21,12 C 21,7.03 16.97,3 12,3 Z" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconType}" Value="{x:Static models:SystemCheckIconType.Saltychat}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Data" Value="M 20,2 L 4,2 C 2.9,2 2,2.9 2,4 L 2,22 L 6,18 L 20,18 C 21.1,18 22,17.1 22,16 L 22,4 C 22,2.9 21.1,2 20,2 Z M 7,9 L 17,9 L 17,11 L 7,11 Z M 7,12 L 13,12 L 13,14 L 7,14 Z" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconType}" Value="{x:Static models:SystemCheckIconType.Discord}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Data" Value="M 20,4 C 18.4,3.3 16.7,2.8 15,2.5 L 14.4,3.8 C 12.8,3.6 11.2,3.6 9.6,3.8 L 9,2.5 C 7.3,2.8 5.6,3.3 4,4 C 1.5,7.8 0.8,11.5 1.1,15.2 C 3.2,16.8 5.3,17.7 7.3,18.4 L 8.5,16.7 C 7.5,16.3 6.6,15.9 5.7,15.3 L 6.3,14.8 C 9.9,16.5 14.1,16.5 17.7,14.8 L 18.3,15.3 C 17.4,15.9 16.5,16.3 15.5,16.7 L 16.7,18.4 C 18.7,17.7 20.8,16.8 22.9,15.2 C 23.3,10.9 22.2,7.2 20,4 Z M 8.5,13 C 7.5,13 6.8,12.1 6.8,11 C 6.8,9.9 7.5,9 8.5,9 C 9.5,9 10.2,9.9 10.2,11 C 10.2,12.1 9.5,13 8.5,13 Z M 15.5,13 C 14.5,13 13.8,12.1 13.8,11 C 13.8,9.9 14.5,9 15.5,9 C 16.5,9 17.2,9.9 17.2,11 C 17.2,12.1 16.5,13 15.5,13 Z" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </Border>

                                <!-- Name & Status -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="{StaticResource PrimaryFontFamily}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontFamily="{StaticResource PrimaryFontFamily}"
                                               FontSize="9.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,1,0,0" />
                                </StackPanel>

                                <!-- Status-Kreis (Grüner Haken / Rotes X) -->
                                <Border Grid.Column="2"
                                        Width="22"
                                        Height="22"
                                        CornerRadius="11"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource StatusErrorSubtleBrush}" />
                                            <Setter Property="BorderBrush" Value="#44EF5350" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource StatusOnlineSubtleBrush}" />
                                                    <Setter Property="BorderBrush" Value="#4434D399" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Path Width="9"
                                          Height="9"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Stroke" Value="{StaticResource StatusErrorBrush}" />
                                                <Setter Property="StrokeThickness" Value="1.8" />
                                                <Setter Property="Data" Value="M 2,2 L 8,8 M 8,2 L 2,8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource StatusOnlineBrush}" />
                                                        <Setter Property="Data" Value="M 1.5,5.5 L 4.2,8.2 L 9,2.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
