<UserControl x:Class="WpfApp1.Components.LauncherSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource LauncherCardBorderStyle}" Padding="20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Karten-Header: LAUNCHER + Zahnrad-Icon rechts -->
            <Grid Grid.Row="0">
                <TextBlock Text="LAUNCHER"
                           Style="{StaticResource SectionEyebrowTextStyle}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />

                <Path Data="M 12,8.5 C 10.07,8.5 8.5,10.07 8.5,12 C 8.5,13.93 10.07,15.5 12,15.5 C 13.93,15.5 15.5,13.93 15.5,12 C 15.5,10.07 13.93,8.5 12,8.5 Z M 19.4,13 L 21,12 L 19.4,11 L 19.1,9.3 L 20.5,8 L 19,6.5 L 17.7,7.9 L 16,7.6 L 15,6 L 13,6 L 12,7.6 L 10.3,7.9 L 9,6.5 L 7.5,8 L 8.9,9.3 L 8.6,11 L 7,12 L 8.6,13 L 8.9,14.7 L 7.5,16 L 9,17.5 L 10.3,16.1 L 12,16.4 L 13,18 L 15,18 L 16,16.4 L 17.7,16.1 L 19,17.5 L 20.5,16 L 19.1,14.7 Z"
                      Stroke="{StaticResource TextSecondaryBrush}"
                      StrokeThickness="1.3"
                      Fill="Transparent"
                      Width="14"
                      Height="14"
                      Stretch="Uniform"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center" />
            </Grid>

            <!-- Optionen mit feiner Trennlinie (wie im Mockup) -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- Option 1: Autostart -->
                <Grid Margin="0,6,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Autostart"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Mit Windows öffnen"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding IsAutoStartEnabled, Mode=TwoWay}" />
                </Grid>

                <!-- Feine Trennlinie -->
                <Border Height="1" Background="{StaticResource DividerBrush}" />

                <!-- Option 2: Beim Spielstart minimieren -->
                <Grid Margin="0,12,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Beim Spielstart minimieren"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Direkt ins Spiel eintauchen"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource ModernToggleSwitchStyle}"
                              IsChecked="{Binding IsMinimizeOnLaunchEnabled, Mode=TwoWay}" />
                </Grid>
            </StackPanel>

            <!-- Dezente Fußzeile in der Karte -->
            <TextBlock Grid.Row="2"
                       Text="Lokal &amp; in Windows gespeichert"
                       FontFamily="{StaticResource PrimaryFontFamily}"
                       FontSize="9.5"
                       Foreground="{StaticResource TextMutedBrush}" />
        </Grid>
    </Border>
</UserControl>
