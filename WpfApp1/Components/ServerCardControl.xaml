<UserControl x:Class="WpfApp1.Components.ServerCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Abschnitt-Header: DEIN SERVER / 01 -->
        <Grid Grid.Row="0" Margin="2,0">
            <TextBlock Text="DEIN SERVER"
                       Style="{StaticResource SectionEyebrowTextStyle}"
                       HorizontalAlignment="Left" />
            <TextBlock Text="01"
                       FontFamily="{StaticResource MonoFontFamily}"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentPrimaryBrush}"
                       HorizontalAlignment="Right" />
        </Grid>

        <!-- Server-Identitätskarte mit subtilem "SIX" Wasserzeichen -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">
            <Grid>
                <!-- Subtiles SIX-Wasserzeichen rechts -->
                <TextBlock Text="SIX"
                           FontFamily="{StaticResource PrimaryFontFamily}"
                           FontSize="66"
                           FontWeight="Black"
                           FontStyle="Italic"
                           Foreground="#FFFFFF"
                           Opacity="0.035"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,-8,-4,-8"
                           IsHitTestVisible="False" />

                <Grid Margin="14,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Z6 Emblem (dunkles Quadrat mit Z weiß & 6 koralle - exakt wie Referenz-CSS) -->
                    <Border Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="8"
                            Background="#222326"
                            BorderBrush="#393332"
                            BorderThickness="1"
                            Margin="0,0,13,0">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Z"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="22"
                                       FontWeight="Black"
                                       FontStyle="Italic"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="-6,-2,0,0" />
                            <TextBlock Text="6"
                                       FontFamily="{StaticResource PrimaryFontFamily}"
                                       FontSize="12"
                                       FontWeight="Black"
                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="12,10,-4,-1" />
                        </Grid>
                    </Border>

                    <!-- Name & Tags -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ServerName}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ServerSubtitle}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Statuszeile: ● In Vorbereitung | Keine Live-Verbindung (in #131416) -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,7">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse Width="6"
                             Height="6"
                             Fill="{StaticResource AccentPrimaryBrush}"
                             Margin="0,0,7,0" />
                    <TextBlock Text="{Binding ServerStatusText}"
                               FontFamily="{StaticResource PrimaryFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#C9CED6" />
                </StackPanel>

                <TextBlock Text="{Binding ServerConnectionNote}"
                           FontFamily="{StaticResource PrimaryFontFamily}"
                           FontSize="9.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Metrik-Karte: SPIELER | LATENZ -->
        <Border Grid.Row="6"
                Background="{StaticResource SurfaceCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SPIELER -->
                <StackPanel Grid.Column="0" Margin="16,0">
                    <TextBlock Text="SPIELER"
                               FontFamily="{StaticResource PrimaryFontFamily}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,5" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding PlayersValue}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text=" / "
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="2,0,2,1" />
                        <TextBlock Text="{Binding PlayersMax}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,1" />
                    </StackPanel>
                </StackPanel>

                <!-- Vertikale Trennlinie -->
                <Border Grid.Column="1"
                        Background="{StaticResource DividerBrush}"
                        Margin="0,2" />

                <!-- LATENZ -->
                <StackPanel Grid.Column="2" Margin="16,0">
                    <TextBlock Text="LATENZ"
                               FontFamily="{StaticResource PrimaryFontFamily}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,5" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding LatencyValue}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text=" ms"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="2,0,0,2" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
