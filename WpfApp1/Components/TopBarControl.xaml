<UserControl x:Class="WpfApp1.Components.TopBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="62">
    <Border Background="{StaticResource TopBarBackgroundBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="12,12,0,0"
            MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
        <Grid Margin="22,0,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Links: ZODIAC SIX Wortmarke + Untertitel + DESKTOP LAUNCHER / CONCEPT 03 -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ZODIAC"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="22"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="SIX"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="22"
                                   FontWeight="Black"
                                   Foreground="{StaticResource AccentGradientBrush}"
                                   Margin="3,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="R O L E P L A Y  ·  N E X T  G E N E R A T I O N"
                               FontFamily="{StaticResource PrimaryFontFamily}"
                               FontSize="7.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="1,-1,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Mittlere Drag-Fläche -->
            <Border Grid.Column="1" Background="Transparent" />

            <!-- Rechts: Minimieren & Schließen -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!-- Minimieren -->
                <Button Style="{StaticResource WindowControlButtonStyle}"
                        ToolTip="Minimieren"
                        Click="MinimizeButton_Click"
                        Margin="0,0,6,0">
                    <Path Data="M 0,5 L 9,5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          Width="9"
                          Height="10"
                          Stretch="None" />
                </Button>

                <!-- Schließen -->
                <Button Style="{StaticResource WindowCloseButtonStyle}"
                        ToolTip="Schließen"
                        Click="CloseButton_Click">
                    <Path Data="M 1,1 L 8,8 M 8,1 L 1,8"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          Width="9"
                          Height="9"
                          Stretch="None" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
